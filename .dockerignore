# Git e metadados
/.git
/.gitignore
/.gitattributes
/.github
/.kilo
/.vscode
/.idea

# Dependências locais (instaladas dentro do build)
/vendor
/node_modules

# Artefatos de build locais (o Dockerfile gera os seus)
/public/build
/public/vendor
/public/hot

# Ambiente e segredos
/.env
/.env.*
/.env.example

# Caches, logs e artefatos do Laravel
/bootstrap/cache/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/framework/testing
/storage/logs/*
/storage/debugbar
/storage/backups
/storage/app/*
!/storage/app/images
!/storage/app/images/**

# Arquivos Docker/CI/docs da raiz (o diretório docker/ é necessário)
/docker-compose*.yml
/Dockerfile
/Dockerfile.*
/docs
/README.md
/supervisor.conf.example
/e2e
/tmp
/backups
/.deploy-backup
/.phpunit.result.cache

# Editores e sistema
*.swp
*.swo
.DS_Store
Thumbs.db
