{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "doctrine/dbal": "^3.10",
        "guzzlehttp/guzzle": "^7.15.2",
        "ismaelw/laratex": "^1.3.0-p1",
        "laravel/framework": "^10.50.4",
        "laravel/sanctum": "^3.3",
        "laravel/socialite": "^5.31",
        "laravel/tinker": "^2.7",
        "monolog/monolog": "^3.0",
        "romanzipp/laravel-queue-monitor": "5.4.5",
        "sentry/sentry-laravel": "^4.31",
        "spatie/laravel-permission": "^6.25",
        "staudenmeir/belongs-to-through": "2.15.1",
        "staudenmeir/eloquent-has-many-deep": "1.19.5",
        "symfony/process": "^6.0",
        "tijsverkoyen/css-to-inline-styles": "^2.4.0",
        "uspdev/laravel-usp-theme": "dev-master#bbbd4cb74eab3a2b1fa57cbc8da8fb683f132d7b",
        "uspdev/replicado": "^1.28.9",
        "uspdev/senhaunica-socialite": "^4.5.12"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24.1",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.5",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan vendor:publish --provider=\"Uspdev\\UspTheme\\ServiceProvider\" --tag=assets --force"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "github-protocols": ["https"],
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/ayrtonnotrya/laravel-usp-theme.git",
            "no-api": true
        }
    ]
}
