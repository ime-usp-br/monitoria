CREATE DATABASE replicado
go

use replicado
go

create table PESSOA (
    codpes int not null,
    nompes varchar(120) not null,
    nompesttd varchar(120) null,
    sexpes char(1) null,
    dtanas datetime null
)
go

create table EMAILPESSOA (
    codpes int not null,
    codema varchar(120) not null,
    stamtr char(1) null
)
go

create table VINCULOPESSOAUSP (
    codpes int not null,
    tipvin varchar(30) not null,
    tipfnc varchar(30) null,
    codset int null,
    dtainivin datetime null,
    dtafimvin datetime null
)
go

create table TELEFPESSOA (
    codpes int not null,
    codddi varchar(5) null,
    codddd varchar(5) null,
    numtel varchar(20) null,
    tiptelpes varchar(20) null
)
go

create table SETOR (
    codset int not null,
    nomabvset varchar(30) not null,
    nomset varchar(120) not null,
    codund int not null,
    tipset varchar(60) null
)
go

create table UNIDADE (
    codund int not null,
    sglund varchar(20) not null,
    nomund varchar(120) not null
)
go

create table TURMAGR (
    coddis varchar(20) not null,
    codtur varchar(20) not null,
    verdis int not null,
    dtainitur datetime null,
    dtafimtur datetime null,
    tiptur varchar(30) null,
    numins int null,
    numinscpl int null,
    numinsopt int null,
    numinsecr int null,
    numinsoptlre int null
)
go

create table DISCIPLINAGR (
    coddis varchar(20) not null,
    verdis int not null,
    nomdis varchar(120) not null
)
go

create table DISCIPGRCODIGO (
    coddis varchar(20) not null,
    codclg int not null,
    pfxdisval varchar(30) null
)
go

create table PREFIXODISCIP (
    codset int not null,
    codclg int not null
)
go

create table MINISTRANTE (
    coddis varchar(20) not null,
    codtur varchar(20) not null,
    codperhor int not null,
    codpes int not null
)
go

create table OCUPTURMA (
    coddis varchar(20) not null,
    codtur varchar(20) not null,
    codperhor int not null,
    diasmnocp varchar(20) null
)
go

create table PERIODOHORARIO (
    codperhor int not null,
    horent varchar(10) null,
    horsai varchar(10) null
)
go

create table PROGRAMAGR (
    codpes int not null,
    codpgm int not null,
    dtaing datetime null,
    stapgm char(1) null
)
go

create table HABILPROGGR (
    codpes int not null,
    codpgm int not null,
    codcur int not null
)
go

create table CURSOGR (
    codcur int not null,
    codclg int not null
)
go

create table COLEGIADO (
    codclg int not null,
    sglclg varchar(20) null,
    codundrsp int null
)
go

create table AGPROGRAMA (
    codpes int not null,
    codare int not null,
    dtaselpgm datetime null,
    nivpgm varchar(5) null
)
go

create table AREA (
    codare int not null,
    codcur int not null
)
go

create table NOMECURSO (
    codcur int not null,
    nomcur varchar(120) not null
)
go

create table CURSO (
    codcur int not null,
    codclg int not null
)
