# Template do nginx dedicado. O entrypoint oficial da imagem nginx substitui
# ${WEB_PORT} em tempo de start (envsubst) e grava /etc/nginx/conf.d/default.conf.
#
# O nginx é o único ponto HTTP da stack; ele não publica portas de host e só é
# alcançável pelo NPM através da rede externa `web` e do alias
# <projeto>-<env>-web.

server {
    listen ${WEB_PORT};
    listen [::]:${WEB_PORT};
    server_name _;

    root /var/www/public;
    index index.php index.html index.htm;

    charset utf-8;
    server_tokens off;
    client_max_body_size 4M;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    error_page 404 /index.php;

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass app:9000;

        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param HTTP_X_FORWARDED_FOR   $http_x_forwarded_for;
        fastcgi_param HTTP_X_FORWARDED_HOST  $http_x_forwarded_host;
        fastcgi_param HTTP_X_FORWARDED_PORT  $http_x_forwarded_port;
        fastcgi_param HTTP_X_FORWARDED_PROTO $http_x_forwarded_proto;
        fastcgi_param HTTP_X_REAL_IP         $http_x_real_ip;

        include fastcgi_params;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
